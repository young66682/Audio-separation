# Create .env next to this file. Never commit a real token.
# Cloud dual-guitar mode uploads the whole song to MVSEP.
MVSEP_API_TOKEN=

# MVSEP full API defaults
MVSEP_API_URL=https://mvsep.com/api
MVSEP_SEPARATION_TYPE=101
MVSEP_MODEL_TYPE=1
MVSEP_OUTPUT_FORMAT=2
# guitar_first: isolate all guitars, then split lead/rhythm.
# direct: run the lead/rhythm model on the full song in one pass.
MVSEP_WORKFLOW=guitar_first
MVSEP_POLL_INTERVAL_SECONDS=3
MVSEP_POLL_RETRIES=5
MVSEP_JOB_TIMEOUT_SECONDS=3600
MVSEP_DOWNLOAD_RETRIES=5
MVSEP_DOWNLOAD_RETRY_DELAY_SECONDS=1.5
# Enable only if MVSEP must be reached through a trusted HTTP proxy.
MVSEP_USE_ENV_PROXY=false

# Local Demucs separation.
# The locked PyTorch build supports CUDA 13.0.
# auto selects CUDA, then Apple MPS, then CPU.
DEMUCS_DEVICE=auto
# Stop a stuck separation after this many seconds (default: 2 hours).
DEMUCS_JOB_TIMEOUT_SECONDS=7200

